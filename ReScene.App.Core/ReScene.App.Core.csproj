<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReScene.App.Core</RootNamespace>
    <UseWPF>false</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WPF head (and any future UI head) still hosts a few ViewModels that
         consume App.Core internal helpers; the test project exercises internals
         directly. This preserves the pre-migration internal/public design. -->
    <InternalsVisibleTo Include="ReScene.NET" />
    <InternalsVisibleTo Include="ReScene.NET.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="..\ReScene.Lib\ReScene\ReScene.csproj" />
  </ItemGroup>
</Project>
