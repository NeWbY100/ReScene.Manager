    public Task<SRRCreationResult> CreateFromSFVAsync(
        string outputPath,
        string sfvFilePath,
        IReadOnlyList<StoredFileEntry>? additionalFiles,
        SRRCreationOptions options,
        CancellationToken ct);
}


