835:	# even if 'rarfile' isn't the first volume, exctraction still succeeds
836:
837:	if extract.returncode != 0:
838:		print("Some unrar error occurred:")
839:		stdout = decodetext(stdout, errors="replace")
840:		print(encodeerrors(stdout, sys.stdout))
841:		return False
842:	return True
