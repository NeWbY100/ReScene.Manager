    public Task<SRRCreationResult> CreateFromRARAsync(
        string outputPath,
        IReadOnlyList<string> rarVolumePaths,
        IReadOnlyList<StoredFileEntry>? storedFiles,
        SRRCreationOptions options,
        CancellationToken ct);

    /// <summary>
