550:    private void MoveSelectedStoredFile(int offset)
551:    {
552:        if (SelectedStoredFile is not { } item)
553:        {
554:            return;
555:        }
556:
557:        int index = StoredFiles.IndexOf(item);
558:        int target = index + offset;
559:        if (index < 0 || target < 0 || target >= StoredFiles.Count)
560:        {
561:            return;
562:        }
563:
564:        // NOT ObservableCollection.Move: Avalonia's DataGridCollectionView.ProcessCollectionChanged
565:        // handles Add/Remove/Replace/Reset but silently drops Move notifications, so a Move reorders
566:        // the list without the grid ever repainting ? the buttons look dead. Remove+Insert raises
567:        // two events the view does handle; the removal clears the grid selection, so restore it.
568:        StoredFiles.RemoveAt(index);
569:        StoredFiles.Insert(target, item);
570:        SelectedStoredFile = item;
571:    }
