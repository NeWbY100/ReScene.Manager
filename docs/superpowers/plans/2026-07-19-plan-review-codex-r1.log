201:
202:`SrrNameCanonicalizer.cs`:
203:
204:```csharp
205:using System.Runtime.InteropServices;
206:using Microsoft.Win32.SafeHandles;
207:
208:namespace ReScene.SRR;
209:
210:/// <summary>
211:/// Single writer-boundary name contract (spec ﾐ岱ｨ1a): OS-final-path containment (resolves every
212:/// ancestor junction/symlink ? Path.GetFullPath alone does not), forward-slash logical names,
213:/// and SFV-entry hardening. Windows-first (GetFinalPathNameByHandle); on non-Windows,
214:/// Path.GetFullPath over a realpath-resolved FileSystemInfo.ResolveLinkTarget chain is
215:/// equivalent because POSIX realpath resolves ancestors.
216:/// </summary>
217:public static class SrrNameCanonicalizer
218:{
219:    public static string GetFinalPath(string path)
220:    {
221:        if (!OperatingSystem.IsWindows())
222:        {
223:            // POSIX: File.ResolveLinkTarget(final) on the deepest existing component is
224:            // realpath-equivalent via GetFullPath of the resolved target.
225:            FileSystemInfo info = Directory.Exists(path)
226:                ? new DirectoryInfo(path) : new FileInfo(path);
227:            FileSystemInfo resolved = info.ResolveLinkTarget(returnFinalTarget: true) ?? info;
228:            return Path.GetFullPath(resolved.FullName);
229:        }
230:
231:        using SafeFileHandle handle = OpenForMetadata(path);
232:        var buffer = new char[1024];
233:        uint length = GetFinalPathNameByHandleW(handle, buffer, (uint)buffer.Length, 0);
234:        if (length == 0 || length > buffer.Length)
235:        {
236:            throw new SrrNameException($"Cannot resolve final path: {path}");
237:        }
238:
239:        string final = new(buffer, 0, (int)length);
240:        return final.StartsWith(@"\\?\", StringComparison.Ordinal) ? final[4..] : final;
241:    }
242:
243:    public static string CanonicalizeRelative(string rootFinalPath, string sourcePath)
244:    {
245:        string source = GetFinalPath(sourcePath);
246:        string root = Path.TrimEndingDirectorySeparator(rootFinalPath);
247:        if (!source.StartsWith(root + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
248:        {
249:            throw new SrrNameException($"Source is outside the release root: {sourcePath}");
250:        }
251:
252:        return source[(root.Length + 1)..].Replace('\\', '/');
253:    }
254:
255:    public static string ResolveSfvEntry(string sfvDirectory, string entryName)
256:    {
257:        string normalized = entryName
258:            .Replace('/', Path.DirectorySeparatorChar)
259:            .Replace('\\', Path.DirectorySeparatorChar);
260:        if (Path.IsPathRooted(normalized))
261:        {
262:            throw new SrrNameException($"SFV entry is rooted: {entryName}");
263:        }
264:
265:        string full = Path.GetFullPath(Path.Combine(sfvDirectory, normalized));
266:        string dir = Path.TrimEndingDirectorySeparator(Path.GetFullPath(sfvDirectory));
267:        if (!full.StartsWith(dir + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
268:        {
269:            throw new SrrNameException($"SFV entry escapes its directory: {entryName}");
270:        }
271:
272:        return full;
273:    }
274:
275:    private static SafeFileHandle OpenForMetadata(string path)
276:    {
277:        // FILE_FLAG_BACKUP_SEMANTICS (0x02000000) lets CreateFileW open directories too.
278:        SafeFileHandle handle = CreateFileW(path, 0, FileShare.ReadWrite | FileShare.Delete,
279:            IntPtr.Zero, FileMode.Open, 0x02000000, IntPtr.Zero);
280:        return handle.IsInvalid
281:            ? throw new SrrNameException($"Cannot open for path resolution: {path}")
282:            : handle;
283:    }
284:
285:    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
286:    private static extern SafeFileHandle CreateFileW(
287:        string lpFileName, uint dwDesiredAccess, FileShare dwShareMode, IntPtr securityAttrs,
288:        FileMode dwCreationDisposition, uint dwFlagsAndAttributes, IntPtr hTemplateFile);
289:
290:    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
291:    private static extern uint GetFinalPathNameByHandleW(
292:        SafeFileHandle hFile, char[] lpszFilePath, uint cchFilePath, uint dwFlags);
293:}
294:```
