225:def strip_zeros(file_name):
226:	"""Sometimes the covers don't have the same leading characters as
227:	the .nfo and .sfv file. In this case the .nfo file is most likely
228:	renamed too. e.g. Gentleman-Runaway-EP-2003-TLT"""
229:	if file_name.startswith(("00-", "00_", "01-", "01_")):
230:		return file_name[3:]
231:	elif file_name.startswith(("000-", "000_", "001-", "001_")):
232:		return file_name[4:]
233:	elif file_name.startswith(("0000-", "0000_", "0001-", "0001_")):
234:		return file_name[5:]
235:	else:
236:		return file_name
