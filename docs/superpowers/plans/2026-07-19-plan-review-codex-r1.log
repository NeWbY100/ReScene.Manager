114:def always_skip(proof, lproof):
115:	# proof file in root directory without the word 'proof' in the name 
116:	# no spaces: skip personal covers added to mp3 releases
117:	# (proof files with spaces exist, but pzs-ng replaces those with . or _)
118:	# Windows Media Player 11:
119:	# creates Folder.jpg, AlbumArtSmall.jpg, desktop.ini
120:	# AlbumArt_{7E518F75-1BC4-4CD1-92B4-B349D9E9248B}_Large.jpg
121:	# AlbumArt_{7E518F75-1BC4-4CD1-92B4-B349D9E9248B}_Small.jpg
122:	always_skip = (" " in os.path.basename(proof) or
123:		os.path.splitext(lproof)[0].endswith("folder") or
124:		"albumartsmall" in os.path.basename(lproof) or
125:		os.path.basename(lproof).startswith("albumart_{"))
126:	return always_skip
