259:def get_image_size(fname):
260:	"""Determine the image type of fhandle and return its size. from draco"""
261:	with open(fname, "rb") as fhandle:
262:		head = fhandle.read(24)
263:		if len(head) != 24:
264:			return
265:		what = imghdr.what(None, head)
266:		if what == "png":
267:			check = struct.unpack(">i", head[4:8])[0]
268:			if check != 0x0d0a1a0a:
269:				return
270:			width, height = struct.unpack(">ii", head[16:24])
271:		elif what == "gif":
272:			width, height = struct.unpack("<HH", head[6:10])
273:		elif what == "jpeg":
274:			try:
275:				fhandle.seek(0)  # Read 0xff next
276:				size = 2
277:				ftype = 0
278:				while not 0xc0 <= ftype <= 0xcf or ftype in (0xc4, 0xc8, 0xcc):
279:					fhandle.seek(size, 1)
280:					byte = fhandle.read(1)
281:					while ord(byte) == 0xff:
282:						byte = fhandle.read(1)
283:					ftype = ord(byte)
284:					size = struct.unpack(">H", fhandle.read(2))[0] - 2
285:				# We are at a SOFn block
286:				fhandle.seek(1, 1)  # Skip `precision" byte.
287:				height, width = struct.unpack(">HH", fhandle.read(4))
288:			except Exception:  #IGNORE:W0703
289:				return
290:		else:
291:			return
292:		return width, height
