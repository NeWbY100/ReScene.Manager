468:	Tries to preserve capitalization on copy from file or sfv.
469:	Passed in from copy_file.
470:	
471:	Returns path to destination file.
472:	"""
473:	# find the proper file on disk (copy_file) and
474:	# choose the file name with capitals (capitals)
475:	# - not conclusive? use original input file name
476:	copy_file, capitals = capitalized_fn(copy_file)
477:
478:	# construct the path for the destination
479:	dest_file = work_dir_file(copy_file, release_dir, working_dir)
480:
481:	# and use proper file captalization
482:	cpath = os.path.dirname(dest_file)
483:	dest_file = os.path.join(cpath, os.path.basename(capitals))
484:
485:	try:
486:		os.makedirs(os.path.dirname(dest_file))
487:	except:
488:		pass
489:
490:	try:
491:		shutil.copyfile(copy_file, dest_file)
492:	except IOError as e:
493:		print("Could not copy %s." % copy_file)
494:		print("Reason: %s" % e)
495:		log = True
496:		if "[Errno 2] No such file or directory" in str(e) and os.name == "nt":
497:			print("Trying again!")
498:			try:
499:				shutil.copyfile("\\\\?\\" + copy_file, dest_file)
500:				log = False
501:			except IOError:
502:				print("Failed again...")
503:				log = True
504:		if log:
505:			logging.error("Failed to copy {0}: {1}".format(copy_file, e))
506:
507:	return dest_file
