509:    /// <summary>
510:    /// Generates the actual .srs/.srr for every placeholder entry into <paramref name="tempDir"/>
511:    /// and returns a map from placeholder to its generated file path. Non-destructive: the
512:    /// placeholders are left untouched (so a retry after a failed/cancelled run ? whose temp dir is
513:    /// deleted ? regenerates cleanly rather than referencing a dead path). Placeholders that fail to
514:    /// generate are simply absent from the map. Called at creation time.
515:    /// </summary>
516:    private async Task<Dictionary<StoredFileItem, string>> MaterializePlaceholdersAsync(string tempDir, SRRCreationOptions options, CancellationToken ct)
517:    {
518:        var srsOptions = new SRSCreationOptions
519:        {
520:            AppName = string.IsNullOrWhiteSpace(AppName) ? "ReScene.NET" : AppName
521:        };
522:
523:        var materialized = new Dictionary<StoredFileItem, string>();
524:        List<StoredFileItem> placeholders = [.. StoredFiles.Where(f => f.Kind != StoredFileKind.Regular)];
525:
526:        await GenerateAndRecordAsync(
527:            placeholders,
528:            (item, index, token) => item.Kind switch
529:            {
530:                StoredFileKind.GeneratedSRS => GenerateSRSFileAsync(item.GenerateFromPath!, tempDir, index, srsOptions, token),
531:                StoredFileKind.GeneratedNestedSRR => GenerateNestedSRRFileAsync(item.GenerateFromPath!, tempDir, index, options, token),
532:                _ => Task.FromResult<string?>(null),
533:            },
534:            (item, generated) => materialized[item] = generated,
535:            ct);
536:
537:        return materialized;
538:    }
