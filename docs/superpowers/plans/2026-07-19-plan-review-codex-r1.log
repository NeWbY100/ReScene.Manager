128:def store_rls_root(proof, rar_files, reldir):
129:	skip_tpl = "'{0}' ({1} B) not added to SRR for release {2}"
130:
131:	# Start with 00 for mp3 releases. Mostly 00- but 00_ exists too:
132:	# VA-Psychedelic_Wild_Diffusion_Part_1-(ESPRODCD01)-CD-2007-hM
133:	# ATB_-_Seven_Years-Ltd.Ed.-2005-MOD (small JPG image file)
134:	# or 000- and 01- or 01_
135:	if os.path.basename(proof).startswith(("00", "01", "001")):
136:		return True
137:
138:	# idea is to not have covers that are added later
139:	# non music releases have a separate folder
140:	if os.path.getsize(proof) > 100000:
141:		# must be named like nfo/sfv/rars
142:		similar_named = similar_to_good_name(proof, rar_files, reldir)
143:		
144:		if similar_named and not fixed_resolution_cover(proof):
145:			return True
146:		else:
147:			msg = skip_tpl.format(
148:				os.path.basename(proof),
149:				rescene.utility.sep(os.path.getsize(proof)),
150:				os.path.basename(reldir))
151:			logging.info(msg)
152:			print(msg)
153:	else:
154:		# Depeche_Mode-Singles_Box_1-6CD-2004-AMOK
155:		# smaller proofs can exist too: use the -i parameter
156:		# -> but .startswith("00") already includes those
157:		# Extra -i option added to add all image files
158:		# and have no separate detection.
159:		# -> but even directly from topsite there can be
160:		#    additional unwanted files e.g. imdb image files
161:		# small JPGs are more likely site grabs by scripts
162:
163:		# log and print the small files info too
164:		msg = skip_tpl.format(
165:			os.path.basename(proof),
166:			rescene.utility.sep(os.path.getsize(proof)),
167:			os.path.basename(reldir))
168:		logging.info(msg)
169:		print(msg)
170:	return False
