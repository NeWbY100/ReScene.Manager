663:- [ ] **Step 3: implement**:
664:
665:```csharp
666:namespace ReScene.App.Core.Services;
667:
668:/// <summary>
669:/// Deterministic release-tree traversal. [DIVERGENCE: determinism] ? pyrescene's byte order is
670:/// raw os.walk enumeration (filesystem-dependent); this emulation sorts each level's directory
671:/// and file names with StringComparer.Ordinal and emits a directory's files before descending,
672:/// per the spec's Ordering paragraph (rev 4). All scanner category passes consume this order.
673:/// </summary>
674:public static class ReleaseTraversal
675:{
676:    public static IReadOnlyList<string> EnumerateFiles(string root)
677:    {
678:        var result = new List<string>();
679:        Walk(root, result);
680:        return result;
681:    }
682:
683:    private static void Walk(string dir, List<string> result)
684:    {
685:        string[] files;
686:        string[] subdirs;
687:        try
688:        {
689:            files = Directory.GetFiles(dir);
690:            subdirs = Directory.GetDirectories(dir);
691:        }
692:        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
693:        {
694:            return; // per-item warning is the SCANNER's job (Task 5); traversal skips silently
695:        }
696:
697:        Array.Sort(files, StringComparer.Ordinal);
698:        Array.Sort(subdirs, StringComparer.Ordinal);
699:        result.AddRange(files);
700:        foreach (string sub in subdirs)
701:        {
702:            Walk(sub, result);
703:        }
704:    }
705:
706:    public static IReadOnlyList<string> FilterByExtension(IReadOnlyList<string> files, string extension) =>
707:        files.Where(f => string.Equals(Path.GetExtension(f), extension, StringComparison.OrdinalIgnoreCase))
708:             .ToList();
709:}
710:```
