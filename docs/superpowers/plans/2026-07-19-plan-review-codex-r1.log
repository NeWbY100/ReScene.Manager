172:def similar_to_good_name(lproof, rar_files, reldir):
173:	basenames = collect_known_good_filenames(reldir, rar_files)
174:	s = 10  # first X characters
175:	p = os.path.basename(lproof)
176:
177:	# for music releases, NFOs not always start with 00
178:	# while all the other files do (sfv, m3u, jpg, cue,...)
179:	# e.g. Hmc_-_187_(UDR011)-VLS-1996-TR
180:	for bn in basenames:
181:		if (bn[:s].lower() == p[:s] or
182:			strip_zeros(bn)[:s].lower() == strip_zeros(p)[:s]):
183:			return True
184:		else:
185:			# checks possible group name before the extension
186:			# e.g. Global_Underground_017_-_Danny_Tenaglia
187:			# _(London)-2000-tronik
188:			#   /gu_017_tracklisting-tronik.jpg
189:			#   /00-global_underground_017_-_danny_tenaglia
190:			#     _(london)-2000-tronik.sfv
191:			#   /01_gu_017_-_london_(cd_1)-tronik.cue
192:			grprls = bn.lower().split('-')[-1]
193:			grpimg = os.path.splitext(lproof)[0].split('-')[-1]
194:			if grprls == grpimg:
195:				return True
196:	return False
