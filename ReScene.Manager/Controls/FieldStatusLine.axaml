<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ReScene.Manager.Controls"
             xmlns:conv="clr-namespace:ReScene.Manager.Converters"
             x:Class="ReScene.Manager.Controls.FieldStatusLine"
             x:Name="Root"
             x:CompileBindings="False"
             VerticalAlignment="Center">
  <UserControl.Resources>
    <conv:FieldStateToGlyphConverter x:Key="FieldStateToGlyph" />
    <conv:FieldStateToBrushConverter x:Key="FieldStateToBrush" />
  </UserControl.Resources>

  <!-- A Grid, not a horizontal StackPanel: a StackPanel measures children with infinite width,
       which silently disables the message's TextWrapping. -->
  <!-- NOT visibility-gated, deliberately, and this is the whole announcement.
       ControlAutomationPeer.GetChildrenCore filters IsVisible=false controls out of a peer's
       children, so a hidden subtree has no automation nodes at all. While this row was gated on
       "state is not None", going from None to Ok/Error did not RENAME the message node — it CREATED
       one, already carrying its text, which raises no name-change for a screen reader to announce.
       The FIRST status a field produces is the one that matters most, and it was the one that could
       not be heard; only transitions between two already-visible states worked.
       Nothing needs hiding: FieldStateToGlyphConverter maps None to an empty string, and an empty
       Status.Message renders nothing, so an idle line shows exactly what it did before.
       MEASURED cost, and it is not zero: an idle line now reserves one caption line box, 18 DIPs,
       where it used to collapse to 0. Per Advanced form with every field idle that is +36
       (CreatorView, SampleRestorerView, SRSCreatorView), +54 (SRSReconstructorView), +18
       (ReconstructorView). Gating the glyph alone instead would have saved none of it: measured, the
       glyph and the message EACH reserve the full 18-DIP line box on their own, so the cost belongs
       to keeping the message realized and is the price of the announcement working at all. -->
  <Grid VerticalAlignment="Center">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Glyph -->
    <TextBlock x:Name="Glyph"
               Grid.Column="0"
               Margin="0,0,4,0"
               FontSize="{DynamicResource FontSizeCaption}"
               VerticalAlignment="Top"
               Text="{Binding Status.State, ElementName=Root, Converter={StaticResource FieldStateToGlyph}}"
               Foreground="{Binding Status.State, ElementName=Root, Converter={StaticResource FieldStateToBrush}}" />

    <!-- Message -->
    <!-- LiveSetting="Polite" makes InputStatus transitions (e.g. "Scanning release folder…" → the
         Ok/Error result) announced by the screen reader without stealing focus. Additive for all five
         task forms — it only adds validation announcements. Not on the
         glyph (Grid.Column="0"): that TextBlock is colour-only decoration. -->
    <TextBlock Grid.Column="1"
               Text="{Binding Status.Message, ElementName=Root}"
               AutomationProperties.LiveSetting="Polite"
               FontSize="{DynamicResource FontSizeCaption}"
               TextWrapping="Wrap"
               VerticalAlignment="Center"
               Foreground="{Binding Status.State, ElementName=Root, Converter={StaticResource FieldStateToBrush}, ConverterParameter=Message}" />
  </Grid>
</UserControl>
