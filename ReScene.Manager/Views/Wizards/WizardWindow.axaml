<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReScene.Manager.Views.Wizards.WizardWindow"
        x:CompileBindings="False"
        Title="{Binding Title}"
        Width="860" Height="800" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" CanResize="True"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundPrimary}"
        FontFamily="{DynamicResource UIFontFamily}">
  <!-- No root FontSize: wizard body text follows the app-wide 12 (default + :is(Window)
       enforcement), keeping Beginner pages consistent with the hub in MainWindow; headings keep
       their explicit tokens. -->
  <!-- A Grid, NOT a DockPanel, and the reason is keyboard order rather than layout.
       Tab order follows TREE order, and a DockPanel's tree order is its DECLARATION order — but a
       DockPanel forces the FILL child to be declared LAST, so the body host could only ever come
       after the footer. MEASURED against a real WizardWindow before this change: on every step
       past the first, a keyboard user tabbed Close -> Back -> Next BEFORE reaching any field of
       the step they were actually on (WCAG 2.4.3 Focus Order). A Grid decouples visual position
       (Grid.Row) from declaration order, so the three bands can be declared header -> body ->
       footer while rendering exactly as before. The row heights Auto/*/Auto reproduce
       Top/fill/Bottom docking exactly; every margin below is this file's own previous value,
       unchanged.
       This is half (b) of the two-part fix the a11y follow-up report's section 8 recorded as
       BINDING: scoping the Create-SRR body's TabIndex pins alone would have left the footer ahead
       of the body, i.e. traded a latent trap for a wrong order on four steps out of five. -->
  <Grid Margin="{DynamicResource PageMargin}" RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeH1}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding StepHeader}"
                 Foreground="{DynamicResource ForegroundSecondary}"
                 FontSize="{DynamicResource FontSizeCaption}" Margin="0,2,0,0" />
    </StackPanel>

    <!-- Body: per-task step panels (DataContext = task VM, injected in code-behind).
         Declared BEFORE the footer so Tab reaches the step's own fields first. -->
    <ContentControl Grid.Row="1" x:Name="BodyHost" />

    <!-- Footer -->
    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <Button DockPanel.Dock="Left" Content="Close" Click="OnCloseClick"
              Classes="ghost" MinWidth="80"
              IsVisible="{Binding IsLastStep, Converter={StaticResource InverseBoolConverter}}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="&#x2039; Back" Command="{Binding BackCommand}"
                Classes="ghost" MinWidth="90" Margin="0,0,8,0"
                IsVisible="{Binding IsBackVisible}" />
        <Button Content="{Binding NextButtonText}" Command="{Binding NextCommand}"
                Classes="primary" MinWidth="90"
                IsVisible="{Binding IsLastStep, Converter={StaticResource InverseBoolConverter}}" />
        <Button Content="Close" Click="OnCloseClick"
                Classes="primary" MinWidth="90"
                IsVisible="{Binding IsLastStep}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
