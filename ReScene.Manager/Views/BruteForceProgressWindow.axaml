<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReScene.Manager.Views.BruteForceProgressWindow"
        x:CompileBindings="False"
        Title="Brute Force Progress"
        Width="920" Height="600"
        MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundPrimary}"
        FontFamily="{DynamicResource UIFontFamily}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Phase label. Polite live region: PhaseDescription changes only at phase boundaries and at
         completion (per-test churn lives in TestCountText/CurrentDetailText), so this announces phase
         transitions and, at the end, the completion status incl. the "N could not run" error aggregate —
         WCAG 4.1.3 status message without per-cell grid chatter. -->
    <TextBlock Grid.Row="0"
               Text="{Binding PhaseDescription}"
               AutomationProperties.LiveSetting="Polite"
               Foreground="{DynamicResource HeaderForeground}"
               FontWeight="Bold" FontSize="{DynamicResource FontSizeH2}"
               Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />

    <!-- Test count + percent row -->
    <DockPanel Grid.Row="1" Margin="0,0,0,2">
      <TextBlock Text="{Binding TestCountText}" />
      <TextBlock Text="{Binding ProgressPercentText}"
                 HorizontalAlignment="Right" DockPanel.Dock="Right" />
    </DockPanel>

    <!-- Progress bar -->
    <ProgressBar Grid.Row="2"
                 Value="{Binding ProgressPercent}"
                 Maximum="100" Height="20"
                 Margin="0,0,0,8" />

    <!-- Current version detail -->
    <TextBlock Grid.Row="3"
               Text="{Binding CurrentDetailText}"
               Foreground="{DynamicResource ForegroundSecondary}"
               Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />

    <!-- Timing stats -->
    <Grid Grid.Row="4" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Elapsed:"
                 Foreground="{DynamicResource ForegroundSecondary}" Margin="0,0,8,2" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ElapsedText}" Margin="0,0,0,2" />

      <TextBlock Grid.Row="0" Grid.Column="2" Text="Remaining:"
                 Foreground="{DynamicResource ForegroundSecondary}" Margin="0,0,8,2" />
      <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding RemainingText}" Margin="0,0,0,2" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed:"
                 Foreground="{DynamicResource ForegroundSecondary}" Margin="0,0,8,0" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SpeedText}" />

      <TextBlock Grid.Row="1" Grid.Column="2" Text="ETA:"
                 Foreground="{DynamicResource ForegroundSecondary}" Margin="0,0,8,0" />
      <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding EtaText}" />
    </Grid>

    <!-- Version list -->
    <DataGrid Grid.Row="5"
              x:Name="VersionGrid"
              ItemsSource="{Binding VersionEntries}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="False"
              ScrollViewer.AllowAutoHide="False"
              HeadersVisibility="Column"
              SelectionMode="Single"
              GridLinesVisibility="None"
              BorderThickness="1"
              BorderBrush="{DynamicResource BorderSubtle}"
              Background="{DynamicResource PanelBackground}"
              Foreground="{DynamicResource ForegroundPrimary}"
              RowBackground="{DynamicResource PanelBackground}"
              Margin="0,0,0,12">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Copy Arguments"
                    Click="OnCopyArgumentsClick" />
          <MenuItem Header="Copy Full Command Line"
                    Click="OnCopyFullCommandLineClick" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <!-- Widths account for Avalonia's DataGrid header chrome (a sort-indicator reserve WPF's custom
             template lacked): the WPF-copied widths clipped "Duration"→"Dura", "No Match"→"No Matc" and
             the HH:mm:ss timestamps. Sized to fit header + content at the 11px/6,4 header density above.
             Set auto-sizes so full set names are visible. Arguments auto-sizes too, so long command lines
             overflow and the grid gets a horizontal scrollbar; ScrollViewer.AllowAutoHide="False" keeps
             that bar always visible instead of the Fluent overlay one that expands on hover. That bar is
             moved below the rows, rather than drawn across the last one, from code-behind: see
             OnVersionGridTemplateApplied. The per-cell ToolTip stays as a quick way to read full text, and
             CanUserResizeColumns (on the DataGrid) lets the user widen columns. -->
        <DataGridTextColumn Header="Set" Binding="{Binding SetText}" Width="Auto" MinWidth="50" />
        <DataGridTextColumn Header="Version" Binding="{Binding VersionName}" Width="140" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="100" />
        <DataGridTextColumn Header="Start" Binding="{Binding StartText}" Width="82" />
        <DataGridTextColumn Header="End" Binding="{Binding EndText}" Width="82" />
        <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="92" />
        <DataGridTemplateColumn Header="Arguments" Width="Auto" MinWidth="180">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Arguments}" ToolTip.Tip="{Binding Arguments}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Auto-scroll toggle + Stop / Close button -->
    <DockPanel Grid.Row="6" LastChildFill="False">
      <CheckBox DockPanel.Dock="Left"
                Content="Auto-scroll"
                IsChecked="{Binding AutoScrollProgress}"
                VerticalAlignment="Center" />
      <Button x:Name="btnStopClose"
              DockPanel.Dock="Right"
              Content="Stop"
              Classes="cancel"
              Padding="20,6"
              MinWidth="90"
              Click="OnStopCloseClick" />
      <Button DockPanel.Dock="Right"
              Content="Open Folder"
              Classes="ghost"
              Padding="20,6"
              MinWidth="90"
              Margin="0,0,8,0"
              Command="{Binding OpenOutputFolderCommand}"
              IsVisible="{Binding LastRunSucceeded}" />
    </DockPanel>

  </Grid>
</Window>
