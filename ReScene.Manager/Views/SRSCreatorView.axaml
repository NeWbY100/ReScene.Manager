<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ReScene.Manager.Controls"
             xmlns:behaviors="clr-namespace:ReScene.Manager.Behaviors"
             x:Class="ReScene.Manager.Views.SRSCreatorView"
             x:CompileBindings="False">

  <Grid Margin="{DynamicResource PageMargin}" x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />                 <!-- 0: Help chrome -->
      <RowDefinition Height="Auto" />                 <!-- 1: config (AutoToStar) -->
      <RowDefinition Height="Auto" />                 <!-- 2: pinned action band -->
      <RowDefinition Height="*" MinHeight="80" />     <!-- 3: log band -->
    </Grid.RowDefinitions>

    <!-- ── Help disclosure (small-window degradation, spec §2) ──
         Single instance, always in the tree: normal mode renders FLAT (header hidden, body
         force-expanded by CompactHeightBehavior) so the page is pixel-identical to the
         pre-disclosure layout; compact mode shows the header and starts collapsed. This view
         has no links (unlike the Reconstructor) — the intro TextBlock is the whole body.
         Margin is NOT a local value here (house rule: local values beat unconditional styles,
         so a local "0,0,0,6" would defeat the compact-mode margin-tightening override) — the
         base value lives in the helpDisclosure style instead. HorizontalAlignment/
         HorizontalContentAlignment ARE local values (the same hug-bug fix Reconstructor's own
         Expander needed): Fluent's Expander defaults to Left, so without this it hugs its own
         content's width instead of filling the Grid column. Deliberately scoped to THIS
         instance rather than the shared helpDisclosure style — a shared-style change would also
         alter Reconstructor's own already-approved frame-rig numbers; no compact-mode override
         ever touches these two properties, so a local value here carries no house-rule risk. -->
    <Expander Grid.Row="0" x:Name="HelpDisclosure" Classes="helpDisclosure"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              AutomationProperties.Name="Help">
      <Expander.Header>
        <TextBlock Text="Help" FontSize="{DynamicResource FontSizeCaption}" />
      </Expander.Header>
      <!-- Body scroller: keyboard route for the text-only body (spec §2 rev 10) —
           Classes="helpBody" is focusable IN COMPACT ONLY via the class-scoped style (an
           always-focusable scroller would add a normal-mode Tab stop, criterion F). Hosts the
           former tab-description TextBlock verbatim, minus its old DockPanel.Dock/margin
           (margin moved to the Expander). Inset on the content panel per house rule. -->
      <ScrollViewer Classes="helpBody" VerticalScrollBarVisibility="Auto"
                    ScrollViewer.AllowAutoHide="False">
        <TextBlock Margin="0,0,4,0"
                   Text="Create an SRS (Sample Rescue Storage) file from a sample video file. The SRS stores enough data to reconstruct the exact sample from any copy of the same video."
                   Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                   TextWrapping="Wrap" />
      </ScrollViewer>
    </Expander>

    <!-- ── Config band (always-present; squeezes + scrolls in compact via AutoToStar) ──
         Content renders at natural height at normal size (row is Auto), no scrollbar shown. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  ScrollViewer.AllowAutoHide="False">
      <StackPanel Margin="0,0,4,0">

        <!-- ── Sample File ─────────────────────────────────────────── -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
          <Run Text="Sample File " FontWeight="SemiBold" />
          <Run Text="— The small sample clip (.mkv, .avi, .mp4, …) to store. Usually in a Sample/ subfolder of the release."
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
        </TextBlock>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse"
                  Command="{Binding BrowseInputCommand}"
                  Classes="ghost"
                  Margin="4,0,0,0" MinWidth="75" />
          <TextBox x:Name="InputTextBox" Text="{Binding InputPath}"
                   behaviors:TextBoxDropBehavior.DropMode="File" />
        </DockPanel>
        <controls:FieldStatusLine Status="{Binding SampleStatus}" />

        <!-- ── ISO file selection (visible only when ISO loaded, single mode) ── -->
        <DockPanel IsVisible="{Binding ShowISOSelection}"
                   Margin="0,4,0,0">
          <TextBlock Text="File inside ISO:" VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding ISOMediaFiles}"
                    SelectedItem="{Binding SelectedISOMediaFile}"
                    FontFamily="{DynamicResource MonoFontFamily}"
                    FontSize="{DynamicResource FontSizeCaption}" />
        </DockPanel>

        <!-- separator -->
        <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

        <!-- ── Main file (optional, for MatchOffset verification) ──────── -->
        <TextBlock Margin="0,0,0,2">
          <Run Text="Main file " FontWeight="SemiBold" />
          <Run Text="(optional — populates MatchOffset, matches pyrescene's -c flag)"
               Foreground="{DynamicResource ForegroundSecondary}"
               FontSize="{DynamicResource FontSizeCaption}" />
        </TextBlock>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse"
                  Command="{Binding BrowseMainFileCommand}"
                  Classes="ghost"
                  Margin="4,0,0,0" MinWidth="75" />
          <Button DockPanel.Dock="Right" Content="Clear"
                  Command="{Binding ClearMainFileCommand}"
                  Classes="ghost"
                  Margin="4,0,0,0" MinWidth="60" />
          <TextBox Text="{Binding MainFilePath}" />
        </DockPanel>
        <controls:FieldStatusLine Status="{Binding MainFileStatus}" Margin="0,2,0,0" />

        <!-- separator -->
        <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

        <!-- ── Output ────────────────────────────────────────────── -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
          <Run Text="Output " FontWeight="SemiBold" />
          <Run Text="— Where the .srs file will be written."
               Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
        </TextBlock>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse"
                  Command="{Binding BrowseOutputCommand}"
                  Classes="ghost"
                  Margin="4,0,0,0" MinWidth="75" />
          <TextBox x:Name="OutputTextBox" Text="{Binding OutputPath}"
                   behaviors:TextBoxDropBehavior.DropMode="File" />
        </DockPanel>
        <controls:FieldStatusLine Status="{Binding OutputStatus}" />

        <!-- separator -->
        <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

        <!-- ── Options ───────────────────────────────────────────── -->
        <TextBlock Text="Options" FontWeight="SemiBold" Margin="0,0,0,2" />
        <DockPanel Margin="0,0,0,2">
          <TextBlock Text="App name:" VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <TextBox Text="{Binding AppName}" Width="400"
                   HorizontalAlignment="Left" />
          <TextBlock Text="Embedded in the SRS file to identify the creating application."
                     VerticalAlignment="Center" Margin="8,0,0,0"
                     Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}" />
        </DockPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- ── Pinned action band — ALWAYS visible (the a11y survey's core defect: this row
         clipped off-screen mid-run). Overlay/adorner implementations forbidden. The two
         separators bracketing it are the SAME two pre-existing Border elements from today's
         markup (the one that used to sit right before the action row, and the one that used to
         sit right before the log) — relocated together, not duplicated. ── -->
    <StackPanel Grid.Row="2">
      <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />

      <!-- ── Action row ────────────────────────────────────────── -->
      <DockPanel Margin="0,0,0,2">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Create SRS"
                  Command="{Binding CreateSRSCommand}"
                  Classes="primary"
                  Padding="16,4" Margin="0,0,4,0" />
          <Button Content="Cancel"
                  Command="{Binding CancelCreationCommand}"
                  Classes="cancel"
                  IsVisible="{Binding IsCreating}"
                  Padding="16,4" />
        </StackPanel>
        <TextBlock Text="{Binding ProgressMessage}"
                   IsVisible="{Binding ShowProgress}"
                   VerticalAlignment="Center" />
      </DockPanel>

      <!-- Progress bar -->
      <ProgressBar Value="{Binding ProgressPercent}"
                   Maximum="100" Height="18"
                   Margin="0,0,0,4"
                   IsVisible="{Binding ShowProgress}" />

      <Border Height="1" Background="{DynamicResource BorderSeparator}" Margin="0,4" />
    </StackPanel>

    <!-- ── Log (fills remaining space) ───────────────────────── -->
    <DockPanel Grid.Row="3">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
        <Button DockPanel.Dock="Right" Content="Save log..."
                Command="{Binding SaveLogCommand}"
                Classes="ghost"
                Padding="8,2" />
        <TextBlock x:Name="LogHeader" DockPanel.Dock="Left" Text="Log" FontWeight="SemiBold" VerticalAlignment="Center" />
        <!-- Live save-outcome line (4.1.3): always in the tree — visibility-toggling would race
             the announcement; empty text renders nothing. No AutomationProperties.Name: the
             announced name IS the text. -->
        <TextBlock x:Name="SaveLogStatus" Text="{Binding SaveLogAnnouncement}"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource ForegroundSecondary}" FontSize="{DynamicResource FontSizeCaption}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
      </DockPanel>
      <ListBox ItemsSource="{Binding LogEntries}"
               Classes="logList"
               AutomationProperties.LabeledBy="{Binding #LogHeader}"
               FontFamily="{DynamicResource MonoFontFamily}"
               FontSize="{DynamicResource MonoFontSize}" />
    </DockPanel>

  </Grid>

</UserControl>
