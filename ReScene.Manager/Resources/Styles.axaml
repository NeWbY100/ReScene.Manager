<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="using:ReScene.Manager.Behaviors">

  <!-- Density parity (see Resources/Density.axaml): the Fluent CheckBox hardcodes Padding 8,0,0,0
       in a literal setter (not a resource), so the WPF 4px glyph→label gap needs a style. -->
  <Style Selector="CheckBox">
    <Setter Property="Padding" Value="4,0,0,0" />
  </Style>

  <!-- 12px content parity (see the ControlContentThemeFontSize note in Density.axaml): the
       Window-level FontSize covers UNSTYLED TextBlocks via inheritance in every window (this is
       an app-level style, so Settings/About/progress windows inherit too). Popup-hosted trees
       (tooltips, menu flyouts) do not inherit from a Window — their themed content follows the
       Density resource instead. -->
  <Style Selector="Window">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- WPF parity: WPF buttons center their content; Avalonia's Fluent Button theme sets no
       content alignment, so any button wider than its text (MinWidth Save/Cancel/Browse
       buttons) renders the label left-hugging. Button.link / Button.recentItem re-assert Left
       further down (later styles win), which is intentional for those. -->
  <Style Selector="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Tab-strip band (pairs with the TabItemHeader* state brushes in Density.axaml): paint the
       tab row's items panel with the surface color so the full-width strip reads as a tab bar,
       WPF App.xaml:332-335 style. The Fluent TabControl's items host is a WrapPanel (the theme's
       own ^ styles target "ItemsPresenter#PART_ItemsPresenter > WrapPanel"), so this selector
       tracks the control theme's structure. -->
  <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
  </Style>
  <!-- Selection pipe: Fluent renders it text-width, hugging the header like a hyperlink underline.
       Make it the WPF selected-tab indicator instead — a 2px accent line across the FULL tab width
       at the bottom edge (WPF App.xaml:372-389). The negative margin mirrors the 12,6 TabItem
       padding (TabItemHeaderMargin in Density.axaml — keep the two in sync). Top placement only:
       every TabControl in the app uses top tabs. -->
  <Style Selector="TabItem[TabStripPlacement=Top] /template/ Border#PART_SelectedPipe">
    <Setter Property="Margin" Value="-12,0,-12,-6" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════
       ReScene Manager shared control style classes
       (functional-parity port of the ~10 SEMANTIC named styles from
       ReScene.NET/App.xaml — NOT a re-template of Fluent's own
       ControlThemes. Layered on top of <FluentTheme> in App.axaml.)

       Fluent's Button/ToggleButton/ListBoxItem ControlThemes already
       theme the templated *ContentPresenter* for :pointerover/:pressed/
       :selected via nested "^:state /template/ ContentPresenter" style
       rules baked into the control theme. A plain Setter on Button.X's
       own Background is NOT enough to change the hover/pressed color —
       Fluent's own state rule keeps re-applying its default brush on
       top of it. The documented Avalonia fix (see "How to style a
       control" in the Avalonia docs) is to add a MORE SPECIFIC selector
       — one that also requires our class — targeting the same
       "/template/ ContentPresenter" combinator; the extra class token
       gives it higher specificity than Fluent's own bare ":pointerover"
       rule, so ours wins without touching the template at all.
       ═══════════════════════════════════════════════════════════ -->

  <!-- ── Button.primary — accent-filled primary action button ──── -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource MediumRadius}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundDisabled}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  </Style>

  <!-- ── Button.cancel — subtle, destructive-leaning secondary button ── -->
  <Style Selector="Button.cancel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentError}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentError}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource MediumRadius}" />
  </Style>
  <!-- No AccentError-tint token exists yet; these opacity variants mirror the WPF
       CancelButton's literal hover/pressed brushes (#33/#55 over AccentError's RGB). -->
  <Style Selector="Button.cancel:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#33F44747" />
  </Style>
  <Style Selector="Button.cancel:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#55F44747" />
  </Style>
  <Style Selector="Button.cancel:disabled">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundDisabled}" />
  </Style>
  <Style Selector="Button.cancel:disabled /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
  </Style>

  <!-- ── Button.ghost — transparent, low-emphasis button ────────── -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource MediumRadius}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <!-- Pressed feedback, consistent with Button.primary:pressed. Mirrors the WPF GhostButton IsPressed
       brush (#FF333333) — a step darker than the hover HoverBackground (#FF3E3E42). No neutral
       "pressed" token exists (like the cancel button's literal hover/pressed hexes above), so the WPF
       literal is used directly. -->
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#FF333333" />
  </Style>
  <Style Selector="Button.ghost:disabled">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundDisabled}" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- ── Button.link — hyperlink-styled button (About window links) ──── -->
  <!-- Transparent chrome + HyperlinkForeground token; the hover state brightens the text
       (HyperlinkHoverForeground) instead of underlining, since Avalonia's TextDecorations is not
       an inherited property and cannot be pushed from Button down into its ContentPresenter's
       implicit TextBlock via a style setter the way Foreground/FontWeight can. -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource HyperlinkForeground}" />
  </Style>
  <Style Selector="Button.link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource HyperlinkHoverForeground}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link:disabled">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundDisabled}" />
  </Style>

  <!-- ── Button.statusVersion — muted status-bar version link ─────
       The MainWindow status-bar version link wants a MUTED rest color (grey, not Button.link's bright
       HyperlinkForeground) that still brightens on hover. It previously carried a LOCAL Foreground,
       which shadowed Button.link:pointerover (a local value outranks a style setter in Avalonia), so
       it never showed any hover affordance. Moving the rest color into a style setter (this class,
       declared AFTER .link so it wins at equal specificity) lets :pointerover override it. -->
  <Style Selector="Button.statusVersion">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondary}" />
  </Style>
  <Style Selector="Button.statusVersion:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource HyperlinkHoverForeground}" />
  </Style>

  <!-- ── ToggleButton.toolbar — compact ghost-style toolbar toggle ── -->
  <Style Selector="ToggleButton.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMedium}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,2" />
    <!-- Compact toolbar toggle: matches the WPF ToolbarToggleButton's explicit FontSize="11". -->
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="{DynamicResource MediumRadius}" />
  </Style>
  <Style Selector="ToggleButton.toolbar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="ToggleButton.toolbar:checked">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ToggleButton.toolbar:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  </Style>
  <Style Selector="ToggleButton.toolbar:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
  </Style>

  <!-- ── Button.recentItem — flat, left-aligned list-row button (Home) ── -->
  <Style Selector="Button.recentItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.recentItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button.recentItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ActiveBackground}" />
  </Style>

  <!-- ── TextBlock.mono — monospaced text ───────────────────────── -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MonoFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
  </Style>

  <!-- ── TextBlock.panelHeader — panel/section header caption ──── -->
  <Style Selector="TextBlock.panelHeader">
    <Setter Property="FontSize" Value="{DynamicResource SectionHeaderFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}" />
  </Style>

  <!-- ── Border.panelHeaderBar — header strip above a panel body ── -->
  <Style Selector="Border.panelHeaderBar">
    <Setter Property="Padding" Value="{DynamicResource PanelHeaderPadding}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelHeaderSeparatorBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- ── Border.section — bordered card used heavily by forms ──── -->
  <Style Selector="Border.section">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource LargeRadius}" />
    <Setter Property="Margin" Value="{DynamicResource SectionCardMargin}" />
  </Style>

  <!-- ── ListBox.logList — compact, monospaced log/terminal list ── -->
  <Style Selector="ListBox.logList">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource LogTerminalForeground}" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <!-- Auto-scroll to the newest log line as entries append (while the user is at the bottom).
         Mirrors the WPF shared log style; see Behaviors/ListBoxAutoScroll.cs. -->
    <Setter Property="behaviors:ListBoxAutoScroll.AutoScrollToEnd" Value="True" />
    <!-- Copy Line / Copy All Lines context menu + the platform copy chord, so getting text out of a
         log never requires a mouse drag-select; see Behaviors/LogListCopy.cs. -->
    <Setter Property="behaviors:LogListCopy.Enable" Value="True" />
    <!-- Scrollbars take layout space instead of overlaying: the Fluent overlay bar (Linux
         especially) draws ON the newest log line — the exact line auto-scroll keeps in view.
         Same rationale as the BruteForceProgressWindow version grid. -->
    <Setter Property="(ScrollViewer.AllowAutoHide)" Value="False" />
  </Style>
  <Style Selector="ListBox.logList ListBoxItem">
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="Foreground" Value="{DynamicResource LogTerminalForeground}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.logList ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="ListBox.logList ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedItemBackground}" />
  </Style>

  <!-- ── DataGridRow — alternating even-row tint ─────────────────
       Avalonia's DataGrid (11.3.13) has no AlternatingRowBackground (WPF did); this restores a subtle
       even-row stripe globally. SystemControlBackgroundListLowBrush (#FF2D2D30) sits one step above the
       grids' PanelBackground for a low-contrast band; odd rows keep the base background.

       Safety: the selector is limited to REST-state even rows via :not(:selected):not(:pointerover).
       An app-level style (this one) outranks the DataGrid control theme's own setters, so without the
       exclusions this even-row Background would win over the Fluent theme's :selected / :pointerover
       row backgrounds. Excluding those pseudo-classes de-activates this setter the moment a row is
       selected or hovered, letting the theme's selection/hover backgrounds show through. Diff tint in
       the Compare property grids is applied at the DataGridCell level (see FileCompareView) and renders
       on top of the row, so it always wins regardless of this row tint. -->
  <Style Selector="DataGridRow:nth-child(even):not(:selected):not(:pointerover)">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
  </Style>

  <!-- ── DataGrid header/cell density (WPF App.xaml:1173-1199) ────
       Fluent's DataGrid renders 14px column headers with generous padding, which overflows the fixed
       column widths ported verbatim from WPF (e.g. "Duration" clips to "Dura", "No Match" to "No Matc"
       on the brute-force grid). Restore WPF's compact chrome: 11px SemiBold secondary-color headers with
       6,4 padding and 6,3 cell padding, so those exact widths fit as they did in WPF. Applies to every
       grid; the Compare diff tint (a DataGridCell Background set in FileCompareView) and the alt-row tint
       above set different properties, so they compose. -->
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondary}" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="6,3" />
  </Style>

  <!-- ── Expander.versionGroup — the WPF-classic expander look for the Versions tree ──
       User feedback preferred the v1.x WPF layout; the markup was always identical, the
       difference was pure theme chrome. This scoped re-template restores it: small LEFT
       chevron (a Path — Shapes expose no automation peer, so it is correctly invisible to
       AT), transparent text-height header instead of Fluent's full-width bar, content
       unboxed. The header stays a STOCK ToggleButton restyled by properties only, keeping
       Fluent's focus ring and Space/Enter handling; IsChecked MUST bind TwoWay
       (TemplateBinding defaults OneWay — one-way silently stops expansion). The
       ExpanderAutomationPeer rides on the control class, unaffected by the template;
       PART_ContentPresenter is the one registration-sensitive name. MinHeight 24 on the
       toggle is the 2.5.8 floor — the sole deliberate deviation from raw WPF density. -->
  <Style Selector="Expander.versionGroup">
    <!-- The group bar spans the tab like v1.9 even when collapsed (content no longer forces width). -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Faithful port of the v1.9 WPF custom Expander template (App.xaml:515-585 at the
             v1.9.0 tag): bordered rounded group, Surface header bar with hover, stroked MDL2-style
             chevron, Panel-tinted body. Deviations from exact-old, both invisible: the header
             stays a FOCUSABLE stock ToggleButton (v1.9 shipped Focusable=False - its header was
             keyboard-unreachable, a defect, not a look), and the chevron is a stroked Path rather
             than the Windows-only Segoe MDL2 font glyph (E76C/E70D) so Linux/macOS render it. -->
        <Border x:CompileBindings="False"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                CornerRadius="{DynamicResource MediumRadius}">
          <StackPanel>
            <!-- COUPLED VALUES: this Background pairs with the :checked override below (rest state
                 paints via TemplateBinding, expanded via the override — both must stay
                 SurfaceBackground or the header shifts color on expand). CornerRadius 3,3,0,0
                 mirrors MediumRadius (=3) so the header's top corners meet the outer Border's
                 radius exactly — retune one, retune both. -->
            <ToggleButton IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Header, StringFormat='RAR {0} versions'}"
                          Background="{DynamicResource SurfaceBackground}" BorderThickness="0"
                          Padding="8,6" MinHeight="24" CornerRadius="3,3,0,0"
                          Cursor="Hand"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- Stroked angle bracket approximating MDL2 E76C; :expanded rotates it 90deg to
                     the E70D down-chevron. Default RenderTransformOrigin IS Center - the string
                     "0.5,0.5" parses as an ABSOLUTE half-pixel and must never come back. -->
                <Path Name="ChevronGlyph" Data="M 1 1 L 5 5 L 1 9"
                      Stroke="{DynamicResource ForegroundSecondary}" StrokeThickness="1.3"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Width="10" Height="10" Stretch="Uniform"
                      VerticalAlignment="Center" />
                <ContentPresenter Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <!-- Visibility gated on the BORDER: gating only the presenter left a 1-2px empty
                 Panel-tinted sliver under every collapsed header. -->
            <Border Background="{DynamicResource PanelBackground}"
                    IsVisible="{TemplateBinding IsExpanded}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- v1.9 leaf density (user-measured: old pitch 18px, new 22px). THREE coupled causes, all
       scoped to this tree: (1) WPF's TabItem FontSize=12 INHERITED into all tab content, so the
       old tree's text was 12px — the port carries 12 only into tab headers, leaving content at
       14; (2) the app-wide CheckBoxMinHeight=20 (Density.axaml); (3) Fluent's 20x20 checkbox box
       primitive (height = max(MinHeight, content), so MinHeight alone cannot shrink a row). Box
       floor 14px per the a11y ruling (WPF's own box was 13x13; brushes untouched so the contrast
       analysis carries). 2.5.8 deviation blessed + recorded in the ledger; invariants: scoped
       here only, header toggle keeps MinHeight >= 24, every leaf stays keyboard-reachable. -->
  <Style Selector="Expander.versionGroup CheckBox">
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Expander.versionGroup CheckBox /template/ Border#NormalRectangle">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <!-- The check-glyph Viewbox is a sibling 20x20 primitive that props the row height even after
       the box shrinks (height = max of the glyph cell's children); it scales its Path content. -->
  <Style Selector="Expander.versionGroup CheckBox /template/ Viewbox">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <!-- The glyph cell's wrapper Grid hardcodes its own 20px height in the Fluent template (the
       one unnamed Grid; RootGrid is the template root). Height only — its width rides the
       RootGrid's fixed glyph column and is harmless to the row. -->
  <Style Selector="Expander.versionGroup CheckBox /template/ Grid:not(#RootGrid)">
    <Setter Property="Height" Value="14" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Expander.versionGroup:expanded /template/ Path#ChevronGlyph">
    <Setter Property="RenderTransform">
      <RotateTransform Angle="90" />
    </Setter>
  </Style>
  <!-- The v1.9 header states: Surface at rest AND expanded (state is the chevron, never color),
       Hover tint on mouse-over. These also suppress Fluent's accent-:checked painting. -->
  <Style Selector="Expander.versionGroup /template/ ToggleButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
  </Style>
  <Style Selector="Expander.versionGroup /template/ ToggleButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
  </Style>
  <Style Selector="Expander.versionGroup /template/ ToggleButton:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
  </Style>
  <Style Selector="Expander.versionGroup /template/ ToggleButton:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
  </Style>
  <Style Selector="Expander.versionGroup /template/ ToggleButton:checked:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}" />
  </Style>

</Styles>
