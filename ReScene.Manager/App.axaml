<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ReScene.Manager.Converters"
             x:Class="ReScene.Manager.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ReScene.Manager/Resources/Tokens.axaml" />
        <!-- WPF-density overrides of Fluent's touch metrics (tab headers, menus, control
             paddings); pairs with DensityStyle="Compact" on FluentTheme below. -->
        <ResourceInclude Source="avares://ReScene.Manager/Resources/Density.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- App-wide converters, reused across Phase-4 views (bool/index -> IsVisible). -->
      <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
      <conv:IndexEqualsConverter x:Key="IndexEqualsConverter" />
      <!-- Compare tab: diff/indent flags -> brush/margin (replace WPF DataTriggers). -->
      <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />
      <conv:IndentDiffBrushConverter x:Key="IndentDiffBrushConverter" />
      <conv:IndentToMarginConverter x:Key="IndentToMarginConverter" />
      <!-- Inspector Text view: word-wrap flag -> TextWrapping (replace WPF DataTrigger). -->
      <conv:BoolToTextWrappingConverter x:Key="BoolToTextWrappingConverter" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- ReScene accent (#FF0078D4) driven via ColorPaletteResources so Fluent's
         derived accent shades (hover/pressed/light/dark variants used by
         controls) are computed from it, not just the bare SystemAccentColor key. -->
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#FF0078D4" />
        <ColorPaletteResources x:Key="Dark" Accent="#FF0078D4" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- Avalonia DataGrid is a separate package with its own Fluent theme; it must be included
         after <FluentTheme> so the grid's control template and cell styling resolve. First used by
         the SRR Creator tab (Stored Files); shared by the other grid-bearing tabs. -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <!-- Semantic control style classes (Button.primary, Border.section, ...), layered on top of
         FluentTheme so they can override its default per-state ContentPresenter styling. -->
    <StyleInclude Source="avares://ReScene.Manager/Resources/Styles.axaml" />
  </Application.Styles>
</Application>
